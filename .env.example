# Copy this file to .env.local and fill in your Supabase project's API details.
# The anon/public key is safe to ship in client-side code — access control is
# enforced by Postgres Row Level Security policies, not by hiding this key.
# Find them at: Supabase dashboard → Project Settings → API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
